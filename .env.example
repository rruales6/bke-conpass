# Local/deploy env. Values normally come from /Users/jruales/secrets/secrets.yaml
# (nested under `conpass:`, loaded by conpass_common.config); these env vars OVERRIDE
# the file when set. Copy to .env for `serverless offline`. NEVER commit a real .env.

# --- Supabase (current key model) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=        # sb_publishable_… (browser-safe, anon/authenticated)
SUPABASE_SECRET_KEY=             # sb_secret_…      (BACKEND ONLY, service_role, bypasses RLS)
SUPABASE_JWKS_URL=               # …/auth/v1/.well-known/jwks.json (asymmetric verify)
SUPABASE_DB_URL=                 # postgres conn string — migrations only, not app runtime

# --- AWS (deploy) ---
AWS_REGION=us-east-1

# --- Google Wallet (Phase 4) ---
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SA_JSON=           # path to service-account .json (or the JSON itself)

# --- Frontend / CORS ---
CONPASS_CORS_ORIGINS=https://conpass.cards,http://localhost:5173

# --- Provider selection (stubbed by default) ---
CONPASS_PAYMENT_PROVIDER=manual
CONPASS_NOTIFICATION_PROVIDER=stub
CONPASS_WALLET_PROVIDER=google

# CONPASS_SECRETS_FILE=/path/to/secrets.yaml
